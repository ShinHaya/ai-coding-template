{
  "$schema": "../agents/config.schema.json",
  "agents": {
    "enabled": ["claude", "codex", "grok", "opencode"],
    "models": {
      "claude": {
        "allow": ["haiku", "opus", "sonnet"],
        "deny": ["*fable*"]
      },
      "codex": {
        "deny": ["*astra*"]
      },
      "opencode": {
        "allow": [
          "opencode/deepseek-v4.1-flash-free",
          "opencode/glm-5.3-flash-free"
        ]
      }
    }
  }
}
