{
  "name": "ai-coding-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dependencies for the Issue orchestration scripts. Only needed if the project uses scripts/issue-*.mjs.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc -p tsconfig.json",
    "test:orchestrator": "node scripts/ai-template.mjs test",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "audit:check": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@langchain/core": "^1.3.2",
    "@langchain/langgraph": "^1.5.3",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
